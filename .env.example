PORT=3000
NODE_ENV=development

# Where data/orders.jsonl (the local order fallback log) is written.
# Optional - defaults to ./data. Override for tests or custom deployments.
DATA_DIR=

SHOPIFY_SHOP_DOMAIN=fleuronss.myshopify.com
# Only needed later if the middleware calls back into Shopify's API (e.g.
# fulfilment write-back). Not required for Phase 1 - orders arrive via a
# Settings -> Notifications webhook, which needs no access token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# The webhook "signing secret" shown under Settings -> Notifications ->
# Webhooks (not an app's client secret - no custom app is used here).
SHOPIFY_WEBHOOK_SECRET=

# Fixed per Petpooja's API guide - same URL for sandbox and production,
# the app_key/app_secret/access_token below identify which account/outlet.
# Only override if Petpooja tells you a different URL.
PETPOOJA_SAVE_ORDER_URL=https://qle1yy2ydc.execute-api.ap-southeast-1.amazonaws.com/V1/save_order
# From the sandbox dashboard's Configuration page (Authentication Tokens).
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
# Shared secret Petpooja must send back on status callbacks (confirm exact mechanism with Petpooja)
PETPOOJA_CALLBACK_SECRET=

# Set to "true" to log the outbound Petpooja payload instead of calling the
# real API - use this while you don't yet have live Petpooja credentials.
PETPOOJA_MOCK_MODE=false

# This server's own public HTTPS origin (no trailing slash), e.g.
# https://fleurons-automation.example.com. Required for real (non-mock)
# Petpooja calls - it's used to build the callback_url Petpooja calls back
# on order status changes (accept/reject/Food Ready).
PUBLIC_BASE_URL=

# Ops alerting - both optional, alerts just log to the console if unset.
# Telegram: create a bot via @BotFather for the token; message the bot once,
# then check https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook alternative (e.g. a Slack incoming webhook URL).
ALERT_WEBHOOK_URL=
